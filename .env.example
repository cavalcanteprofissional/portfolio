# Hugging Face token — used by the resume pipeline (resume/translate.py) for
# faster mBART model downloads & higher rate limits.
# - CI: injected as the GitHub Secret `HF_TOKEN` (.github/workflows/deploy.yml).
# - Local: copy this file to `.env.local` (git-ignored) with your real token,
#   or export HF_TOKEN in your shell. The pipeline loads `.env.local` itself.
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
