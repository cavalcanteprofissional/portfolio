# Configuração do backend real (Fase 3) — preenchido no Cloudflare Worker, nunca no bundle.
# Variáveis VITE_ expostas no cliente devem conter apenas chaves públicas/anon.
#
# Supabase (anon key pública — pode ir no bundle)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
#
# Umami (pública — pode ir no bundle)
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=
#
# URL do Cloudflare Worker (pública — pode ir no bundle)
# VITE_WORKER_URL=
