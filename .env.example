# Copie este arquivo para `.env.local` e preencha os valores (estes estão sem valor)
# Variáveis VITE_ são expostas no bundle e devem conter APENAS chaves públicas/anon.
#
# Hugging Face (SECRETA — pipeline de currículo; nunca no bundle do site)
# HF_TOKEN=
#
# Supabase — URL do projeto (PÚBLICA — pode ir no bundle)
# VITE_SUPABASE_URL=
#
# Supabase — anon key (PÚBLICA — pode ir no bundle)
# VITE_SUPABASE_ANON_KEY=
#
# Umami — website ID (PÚBLICA — pode ir no bundle)
# VITE_UMAMI_WEBSITE_ID=
#
# Umami — script src (PÚBLICA — pode ir no bundle)
# VITE_UMAMI_SRC=
#
# URL do Cloudflare Worker (PÚBLICA — pode ir no bundle)
# VITE_WORKER_URL=
#
# Brevo — API key (SECRETA — do Worker, NUNCA no bundle; vai via `wrangler secret put BREVO_API_KEY`)
# BREVO_API_KEY=
